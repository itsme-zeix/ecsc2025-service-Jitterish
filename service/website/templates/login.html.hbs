{{#*inline "page"}}
    <h1>Rocket Session: Please Login</h1>

    <p>Please login to continue.</p>

    <form action="/session/login" method="post" accept-charset="utf-8">
        <label for="username">username</label>
        <input type="text" name="username" id="username" value=""/>
