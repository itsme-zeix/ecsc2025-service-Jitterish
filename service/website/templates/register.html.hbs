{{#*inline "page"}}
    <h1>Register</h1>

    <div data-augmented-ui="" class="main-card">
        <form action="/session/register" method="post" accept-charset="utf-8">
            <label for="username">username</label>
            <input type="text" name="username" id="username" value="" required minlength="3" pattern="\w{3,}"/>

            <br>
            <label for="password">password</label>
            <input type="password" name="password" id="password" value="" required minlength="8"/>

            <br>
            <label for="firstname">First name</label>
            <input type="text" name="firstname" id="firstname" value="" required/>

            <br>
            <label for="lastname">Last name</label>
            <input type="text" name="lastname" id="lastname" value="" required/>

            <br>

             <input type="radio" id="personal" name="accounttype" value="personal">
             <label for="personal">personal</label><br>
             <input type="radio" id="business" name="accounttype" value="business">
             <label for="business">business</label><br>

            <br>
            <p><input data-augmented-ui type="submit" value="register"></p>
        </form>
    </div>
{{/inline}}
{{> default title="Register" pagename="register"}}
