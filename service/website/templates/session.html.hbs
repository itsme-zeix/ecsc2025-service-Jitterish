{{#*inline "page"}}
    <h1>Your Account</h1>
    <p>Logged in with user &quot;{{ username }}&quot;.</p>

    <br>
    <button onclick="location.href='/database/{{username}}'">Manage db</button>

    <form action="/session/logout" method="post" accept-charset="utf-8">
        <input type="submit" name="logout" id="logout" value="logout"/>
    </form>
{{/inline}}
{{> default title="Your Account"}}
